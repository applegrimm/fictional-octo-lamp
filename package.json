{
  "name": "fictional-octo-lamp",
  "version": "1.0.0",
  "private": true,
  "description": "テイクアウト予約フォーム（GitHub Pages + Google Apps Script）",
  "scripts": {
    "gas:setup": "node scripts/setup-clasp.mjs",
    "gas:login": "clasp login",
    "gas:status": "clasp status && clasp deployments",
    "gas:push": "clasp push --force",
    "gas:deploy": "node scripts/deploy-gas.mjs",
    "gas:release": "npm run gas:push && npm run gas:deploy",
    "gas:open": "clasp open",
    "gas:logs": "clasp logs --watch",
    "check": "node scripts/check.mjs"
  },
  "devDependencies": {
    "@google/clasp": "^2.4.2"
  }
}
